# --- Project-critical (the rules that actually matter) ---
# imported CSVs/PDFs and runtime data — ALL subscriber content lives here
data/
# warroom.db and any SQLite artifacts
*.db
*.db-journal
*.db-wal
*.db-shm
.env
.env.*

# --- Python (backend) ---
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Node / React (frontend) ---
node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*

# --- OS / editor noise ---
.DS_Store
Thumbs.db
.idea/
.vscode/

# Cursor
#  Cursor is an AI-powered code editor. `.cursorignore` specifies files/directories to
#  exclude from AI features like autocomplete and code analysis. Recommended for sensitive data
#  refer to https://docs.cursor.com/context/ignore-files
.cursorignore
.cursorindexingignore
